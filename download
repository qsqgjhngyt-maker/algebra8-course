const {spawn}=require('child_process'),fs=require('fs'),path=require('path'),assert=require('assert/strict');
const root=path.resolve(process.env.KITSUNE_QA_ROOT||path.join(__dirname,'../..')),python=process.env.PYTHON_PATH||'python';
const get=url=>new Promise((resolve,reject)=>require('http').get(url,r=>{r.resume();r.on('end',()=>resolve({status:r.statusCode,headers:{get:key=>r.headers[key]}}));r.on('error',reject)}).on('error',reject));
const child=spawn(python,[path.join(root,'LAN_SERVER.py'),'--port','18765'],{cwd:root,windowsHide:true,env:{...process.env,PYTHONUNBUFFERED:'1',PYTHONIOENCODING:'utf-8'}});let log='';child.stdout.on('data',b=>log+=b);child.stderr.on('data',b=>log+=b);
(async()=>{for(let i=0;i<50&&!log.includes('18765');i++)await new Promise(r=>setTimeout(r,100));const results=[];for(const name of ['index.html','platform-v300.js','math-lab-v130.js','sw.js','manifest.json','version.json']){const r=await get('http://127.0.0.1:18765/'+name);assert.equal(r.status,200,name);if(name.endsWith('.js'))assert(/javascript/.test(r.headers.get('content-type')),name+' MIME');results.push({file:name,status:r.status,mime:r.headers.get('content-type')})}console.log('PASS bundled LAN_SERVER.py: HTML, JS MIME, SW, manifest, release metadata');fs.writeFileSync(path.join(__dirname,'server-results.json'),JSON.stringify({status:'PASS',files:results},null,2));})().catch(e=>{console.error(e,log);process.exitCode=1}).finally(()=>child.kill());
